{
  "name": "mantine-form-zod-resolver",
  "description": "Zod resolver for @mantine/form validation",
  "packageManager": "yarn@4.12.0",
  "version": "1.3.0",
  "type": "module",
  "author": "Vitaly Rtishchev <rtivital@gmail.com>",
  "engines": {
    "node": ">=16.6.0"
  },
  "keywords": [
    "typescript",
    "template"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantinedev/mantine-form-zod-resolver.git"
  },
  "bugs": {
    "url": "https://github.com/mantinedev/mantine-form-zod-resolver/issues"
  },
  "homepage": "https://github.com/mantinedev/mantine-form-zod-resolver#readme",
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "generate-dts": "esno scripts/generate-dts",
    "build": "rollup -c rollup.config.mjs && npm run generate-dts",
    "prettier:check": "node ./node_modules/prettier/bin/prettier.cjs --check \"**/*.{ts,tsx}\"",
    "prettier:write": "node ./node_modules/prettier/bin/prettier.cjs --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ext .ts,.tsx .",
    "jest": "jest",
    "test": "npm run prettier:check && npm run typecheck && npm run lint && npm run jest",
    "release": "npm test && esno scripts/release"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@mantine/form": "^8.3.15",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/signale": "^1.4.7",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "eslint-config-mantine": "^4.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "esno": "^4.8.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "new-github-release-url": "^2.0.0",
    "open": "^11.0.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.58.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-node-externals": "^8.1.2",
    "signale": "^1.4.0",
    "simple-git": "^3.31.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "version-next": "^1.0.2",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@mantine/form": ">=7.0.0",
    "zod": ">=4.0.0"
  }
}
